# Copy this file to .env and fill in your own values.
# calendar-mcp loads .env from the current working directory on startup.

# --- Google OAuth 2.0 client (required) ------------------------------------
# Create OAuth 2.0 credentials of type "Desktop app" in the Google Cloud
# console, enable the Google Calendar API, and paste both values here.
GOOGLE_CLIENT_ID='YOUR_GOOGLE_CLIENT_ID_HERE'
GOOGLE_CLIENT_SECRET='YOUR_GOOGLE_CLIENT_SECRET_HERE'

# Where the user's OAuth token is cached after `calendar-mcp auth`.
# Default: .gcp-saved-tokens.json in the current working directory.
TOKEN_FILE_PATH='.gcp-saved-tokens.json'

# Local port the OAuth callback server listens on during `calendar-mcp auth`.
# A "Desktop app" OAuth client accepts http://localhost on any port, so the
# resulting redirect URI needs no registration -- change this only if 8080 is taken.
OAUTH_CALLBACK_PORT=8080

# Scopes requested from Google.
# https://developers.google.com/calendar/api/guides/auth
CALENDAR_SCOPES='https://www.googleapis.com/auth/calendar'
# Read-only alternative:
# CALENDAR_SCOPES='https://www.googleapis.com/auth/calendar.readonly'

# --- Server behaviour ------------------------------------------------------
# Allow the server itself to open a browser for the OAuth consent screen when
# no valid token exists. Off by default: an MCP client launching the server
# over stdio has no way to show a consent screen, so the server would hang.
# Leave this unset and run `calendar-mcp auth` once instead.
# CALENDAR_MCP_ALLOW_BROWSER_AUTH=1

# Mirror the stderr log to a file. Logs never go to stdout, because stdout is
# the MCP protocol channel in stdio mode.
# CALENDAR_MCP_LOG_FILE=calendar-mcp.log

# Logging verbosity: DEBUG, INFO, WARNING, ERROR or CRITICAL.
# Overrides --log-level.
# CALENDAR_MCP_LOG_LEVEL=INFO

# --- HTTP transport (only used with `calendar-mcp --transport http`) --------
# Interface to bind (default 127.0.0.1). Same as --host.
# HOST=127.0.0.1

# Port to listen on (default 8000). Same as --port.
# PORT=8000
